# Base URL of the Django API (no trailing slash). Required in production.
VITE_API_BASE_URL=https://peddel.stride-events.net
# Public tournament website (used for share links / QR targets shown in the UI)
VITE_PUBLIC_SITE_URL=https://peddel-frontend.vercel.app
# Optional: override WebSocket base (defaults to the API base with ws/wss)
# VITE_WS_BASE_URL=wss://api.example.com
